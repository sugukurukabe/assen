          "現場作業", "建設作業", "とび職", "左官", "大工作業", "掘削", "重機運転",
          "施工補助（作業）", "建設業務"
        ],
        "port": [
          "港湾運送", "荷役", "沖仲仕", "港湾荷役", "船内荷役", "沿岸荷役"
        ]
      },
      "allowedSupervisorKeywords": [
        "施工管理", "現場監督", "工事管理者", "工事監理", "現場代理人",
        "工程管理", "品質管理", "安全管理", "設計", "現場事務", "施工管理アシスタント",
        "superintendent", "project manager", "PM"
      ],
      "titleOnlyNotEnough": true,
      "note": "肩書ではなく実作業ベースで判定する。監督の肩書で実態が現場作業ならブロック。"
