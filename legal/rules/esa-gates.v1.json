    "G2": {
      "name": "労働条件の明示（④交付）",
      "requiredDocType": "t2p_job_order_notice",
      "requiredBefore": "referral"
    },
    "G3": {
      "name": "個人情報・第三者提供同意（⑤取得）",
      "requiredDocType": "t2p_consent_form",
      "requiredBefore": "resume_share"
    },
    "G5": {
      "name": "手数料（求職者無料・成立後請求・転職勧奨2年禁止）",
      "jobSeekerFeeForbidden": true,
      "chargeOnlyAfterHire": true,
      "noPoachingYears": 2
    },
    "G6": {
      "name": "的確表示（広告）",
      "forbiddenPhrases": [
        "就職お祝い金", "お祝い金", "紹介料還元", "キャッシュバック",
